{
  "compilerOptions": {
    "noImplicitReturns": true,
    "outDir": "./dist",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",
    "allowJs": true
  },
  "include": ["src"]
}
